<?xml version="1.0" encoding="utf-8"?>
<!--
  แอปโน้ตบนมือถือ — เจ้าของสั่ง 21 ก.ย. 2569 "ติดตั้งเป็น apk ในเครื่องผมเลย"

  แอปนี้เป็น "หน้าต่าง" ไปยังสมุดโน้ตที่อยู่บนคอม ไม่ได้เก็บข้อมูลเองเลย
  ข้อมูลอยู่ที่เครื่องคอมที่เดียว เข้าถึงผ่าน Tailscale
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.pipeline.notes">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="false"
      android:allowBackup="false"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
