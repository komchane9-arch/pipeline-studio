<?xml version="1.0" encoding="utf-8"?>
<!--
  Android ห้ามต่อแบบไม่เข้ารหัส (http) ตั้งแต่ Android 9 เป็นต้นมา

  **เปิด http ทั้งแอป โดยตั้งใจ** — ตอนแรกทำเป็นรายชื่อที่อนุญาต แล้วเจอปัญหา
  วัดจริง 21 ก.ย. 2569: ในเครื่องเดียวกัน curl เข้า http://192.168.1.101:8866
  ได้ 200 แต่แอปเข้าไม่ได้เลย เพราะที่อยู่นั้นไม่อยู่ในรายชื่อ

  ที่แย่กว่านั้นคือช่อง "แก้ที่อยู่เอง" ในแอป — พิมพ์ที่อยู่ http ใหม่เข้าไป
  แล้วมันจะล้มเงียบๆ โดยไม่บอกว่าเพราะถูกบล็อก คนใช้จะนึกว่าพิมพ์ผิดแล้วไล่
  แก้ผิดจุด นั่นคือด่านที่ทำให้เข้าใจผิด ซึ่งแย่กว่าไม่มีด่าน (กติกาข้อ 2.3)

  ความเสี่ยงที่แลกมา: ลิงก์ http ที่กดจากในโน้ตจะไม่เข้ารหัส — เท่ากับเบราว์เซอร์
  ทั่วไป และลิงก์ร้านค้าจริง (Shopee/Lazada) เป็น https อยู่แล้วทั้งหมด
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
